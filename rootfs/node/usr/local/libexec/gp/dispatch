#!/bin/bash
# The architect's only way onto a node. Its key's authorized_keys entry forces this command,
# so it can run nothing but the allowlisted, idempotent actions below, each logged.
set -euo pipefail
read -r -a words <<<"${SSH_ORIGINAL_COMMAND:-}"
action="${words[0]:-}"
args=("${words[@]:1}")
case "$action" in
  nginx-apply|api-legacy-stop|pg-replica-create|pg-replica-remove|pg-cap|pgbouncer-start|pgbouncer-stop|status) ;;
  *) logger -t gp-dispatch "refused: ${SSH_ORIGINAL_COMMAND:-}"; echo "refused: $action" >&2; exit 64 ;;
esac
for a in "${args[@]}"; do
  if [[ ! "$a" =~ ^[A-Za-z0-9._:%/-]{1,64}$ ]]; then
    logger -t gp-dispatch "refused argument for $action: $a"; echo "refused argument: $a" >&2; exit 64
  fi
done
logger -t gp-dispatch "run: $action ${args[*]}"
exec /usr/local/libexec/gp/actions/"$action" "${args[@]}"
