[Unit]
Description=Growing Pains architect
After=network-online.target k3s.service prometheus.service
[Service]
EnvironmentFile=/etc/gp/architect.env
ExecStart=/usr/local/bin/gp-architect -listen=:7000 -prometheus=http://127.0.0.1:9090 -grafana=http://127.0.0.1:3000 -actuator=playground -playground=/etc/gp/playground.json $GP_ARCHITECT_ARGS
StateDirectory=gp-architect
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
